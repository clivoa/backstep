{
  "uid": "rollback-netcode",
  "title": "Rollback Netcode",
  "tags": ["rollback", "netcode", "lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1s",
  "time": { "from": "now-5m", "to": "now" },
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "peer",
        "label": "Peer",
        "type": "custom",
        "query": "local,remote",
        "current": { "text": "local", "value": "local" },
        "options": [
          { "text": "local", "value": "local", "selected": true },
          { "text": "remote", "value": "remote", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sessão",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Desync",
      "description": "1 significa que dois checksums de frames confirmados divergiram. A sessão já terminou.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "rollback_desync", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "DESYNC", "color": "red", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Profundidade de previsão",
      "description": "Quantos frames à frente do peer estamos especulando agora. O limite é 8; encostar nele significa stall.",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [{ "expr": "rollback_prediction_depth", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Acurácia da previsão",
      "description": "Fração dos frames previstos que se confirmaram. 1 = nenhuma correção necessária.",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "targets": [
        { "expr": "rollback_prediction_accuracy{peer=\"$peer\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "RTT suavizado",
      "description": "Round-trip time. Não há latência unidirecional aqui: os relógios dos dois peers não são sincronizados.",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [{ "expr": "rollback_srtt_seconds{peer=\"$peer\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tamanho do estado",
      "description": "Bytes de um snapshot. A arena tem 204; o SFA3 sob FBNeo tem alguns megabytes.",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [{ "expr": "rollback_state_bytes{peer=\"$peer\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Rollback",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rollbacks por segundo",
      "description": "Cada rollback é uma previsão que não se confirmou. Comparar os dois peers: quem está atrás corrige mais.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(rollback_rollbacks_total[15s])", "legendFormat": "{{peer}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 12 } } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Profundidade do rollback",
      "description": "Frames re-simulados por correção, e a profundidade máxima já vista.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "rate(rollback_frames_resimulated_total[15s]) / clamp_min(rate(rollback_rollbacks_total[15s]), 0.001)",
          "legendFormat": "média {{peer}}",
          "refId": "A"
        },
        { "expr": "rollback_max_depth_frames", "legendFormat": "máx {{peer}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 8 } } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Trabalho extra de simulação",
      "description": "Frames re-simulados por frame apresentado. 0 = nenhum rollback; 1 = a CPU simulou tudo duas vezes.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(rollback_frames_resimulated_total[30s]) / clamp_min(rate(rollback_frames_presented_total[30s]), 0.001)",
          "legendFormat": "{{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 12 } } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Stalls",
      "description": "Frames em que a janela de previsão encheu e a simulação parou para esperar o peer.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "rate(rollback_stalls_total[15s])", "legendFormat": "{{peer}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20 } } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Rede",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "RTT e variação",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "expr": "rollback_srtt_seconds", "legendFormat": "srtt {{peer}}", "refId": "A" },
        { "expr": "rollback_rttvar_seconds", "legendFormat": "var {{peer}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 6 } } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Perda, duplicação e reordenação",
      "description": "A perda é inferida a partir das lacunas na sequência do peer; um datagrama atrasado aparece como perda até chegar.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "rollback_loss_ratio", "legendFormat": "perda {{peer}}", "refId": "A" },
        { "expr": "rate(rollback_duplicates_total[30s])", "legendFormat": "dup/s {{peer}}", "refId": "B" },
        { "expr": "rate(rollback_reordered_total[30s])", "legendFormat": "reord/s {{peer}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 6 } } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Bitrate",
      "description": "Só inputs trafegam. Um InputBatch a 60 Hz com oito inputs repetidos cabe em ~35 kbit/s.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "targets": [
        { "expr": "rollback_send_bitrate_bps", "legendFormat": "envio", "refId": "A" },
        { "expr": "rollback_receive_bitrate_bps", "legendFormat": "recepção", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Datagramas rejeitados",
      "description": "Falhas de HMAC e pacotes malformados. Diferente de zero em produção significa que alguém está mandando lixo na porta.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "targets": [
        { "expr": "rate(rollback_auth_failures_total[30s])", "legendFormat": "hmac", "refId": "A" },
        { "expr": "rate(rollback_malformed_total[30s])", "legendFormat": "malformado", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20 } } }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Custo de execução",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Tempo por frame",
      "description": "Quanto de cada frame vai em advance_frame, save_state e load_state. A 60 Hz o orçamento total é 16,7 ms.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 37 },
      "targets": [
        { "expr": "rate(rollback_advance_seconds_total[15s]) / clamp_min(rate(rollback_frames_presented_total[15s]) + rate(rollback_frames_resimulated_total[15s]), 0.001)", "legendFormat": "advance", "refId": "A" },
        { "expr": "rate(rollback_save_state_seconds_total[15s]) / clamp_min(rate(rollback_frames_presented_total[15s]) + rate(rollback_frames_resimulated_total[15s]), 0.001)", "legendFormat": "save_state", "refId": "B" },
        { "expr": "rate(rollback_load_state_seconds_total[15s]) / clamp_min(rate(rollback_rollbacks_total[15s]), 0.001)", "legendFormat": "load_state por rollback", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 5, "custom": { "fillOpacity": 6 } } }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "CPU e memória do processo",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 37 },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[30s])", "legendFormat": "cpu", "refId": "A" },
        { "expr": "process_resident_memory_bytes", "legendFormat": "rss", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 6 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "rss" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      }
    }
  ]
}
